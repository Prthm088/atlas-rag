APP_ENV=development
APP_NAME=Atlas API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Use the Supavisor session pooler URL (port 5432) for Render.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_VERIFY_MODE=jwks

GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_KEY
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_FILE_BYTES=10485760
MAX_DOCUMENTS_PER_USER=5
MAX_STORAGE_BYTES_PER_USER=52428800
MAX_PDF_PAGES=200
MAX_CHUNKS_PER_DOCUMENT=1200
CHAT_REQUESTS_PER_MINUTE=12
UPLOADS_PER_HOUR=10

JOB_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3
CONVERSATION_RECENT_MESSAGES=12
CONVERSATION_SUMMARY_TRIGGER=18
RETRIEVAL_VECTOR_LIMIT=30
RETRIEVAL_KEYWORD_LIMIT=30
RETRIEVAL_FINAL_LIMIT=8

# Local-only alternative used by Docker/tests; production must use supabase.
STORAGE_BACKEND=supabase
LOCAL_STORAGE_PATH=.data/storage
